// ---------------------------------------------------------------------------
//  Burrows-Wheeler reversibile, seguendo
//    Lyngby, Nylandsted, Gluck, Yokoyama,
//    "Towards Clean Reversible Lossless Compression", RC 2024.
//
//  Come nel lavoro di riferimento il blocco, le rotazioni ordinate e la colonna
//  trasformata sono array: la cella j si legge in tempo costante, senza
//  consumarla e senza toccare le altre. Il resto della struttura e' la loro: una
//  procedura che produce l'uscita piu' i dati ausiliari, e i dati ausiliari
//  azzerati disfacendo la procedura che li ha prodotti.
//
//  Alfabeto ridotto: a=1, b=2, n=3.
//  Vettore di prova: "banana" -> ultima colonna "nnbaaa", indice 3.
// ---------------------------------------------------------------------------

// --- carattere k-esimo della rotazione che parte da off --------------------
//
//  Il modulo non si scrive con l'operatore ma con un if: j e' una variabile
//  locale che va riportata a zero, quindi la correzione j -= n deve poter
//  essere disfatta, e per disfarla serve sapere se e' avvenuta. La guardia
//  d'uscita j < off lo dice.
procedure car(int blocco[], int n, int off, int k, int c)
    local int j = 0
        j += off
        j += k
        if j >= n then
            j -= n
        fi j < off
        c += blocco[j]
        if j < off then
            j += n
        fi j >= n
        j -= k
        j -= off
    delocal int j = 0

// --- confronto lessicografico di due rotazioni -----------------------------
//
//  gt vale 1 se la rotazione da o1 e' maggiore di quella da o2; pref conta le
//  posizioni iniziali in cui coincidono.
//
//  Non si esce in anticipo al primo carattere diverso: la guardia d'uscita di un
//  if non distinguerebbe "sono entrato e non ho trovato" da "non sono entrato".
//  pref fa da testimone: finche' le due rotazioni coincidono vale esattamente k,
//  quindi `pref == k` dice "siamo ancora nel prefisso comune". Dopo il corpo pref
//  vale k oppure k+1, in entrambi i casi >= k, mentre se non si e' entrati e'
//  rimasto sotto k: `pref >= k` e' quindi una guardia d'uscita valida.
procedure maggiore(int blocco[], int n, int o1, int o2, int gt, int pref)
    local int k = 0
    from k == 0 do
        local int c1 = 0
        local int c2 = 0
            call car(blocco, n, o1, k, c1)
            call car(blocco, n, o2, k, c2)
            if pref == k then
                if c1 > c2 then
                    gt += 1
                fi gt == 1
            fi pref >= k
            if pref == k then
                if c1 == c2 then
                    pref += 1
                fi pref > k
            fi pref >= k
            uncall car(blocco, n, o2, k, c2)
            uncall car(blocco, n, o1, k, c1)
        delocal int c2 = 0
        delocal int c1 = 0
        k += 1
    loop until k == n
    delocal int k = n

// --- ordinamento a bolle delle rotazioni -----------------------------------
//
//  Un passo confronta le rotazioni in posizione j e j+1 e le scambia se sono
//  in ordine sbagliato. Gli offset letti finiscono su `scarto` invece di essere
//  disfatti: dopo lo scambio non si saprebbe piu' quale cella porta quale
//  valore, e la guardia dovrebbe dipendere da gt, che a quel punto e' gia'
//  stato azzerato. `scarto` e' un dato ausiliario nel senso del paper, e lo
//  ripulisce chi disfa l'ordinamento.
procedure passo(int offs[], int blocco[], stack scarto, int n, int j)
    local int j1 = 0
        j1 += j
        j1 += 1
        local int o1 = 0
        local int o2 = 0
            o1 += offs[j]
            o2 += offs[j1]

            local int gt = 0
            local int pref = 0
                call maggiore(blocco, n, o1, o2, gt, pref)
                if gt == 1 then
                    offs[j] <=> offs[j1]
                fi gt == 1
                uncall maggiore(blocco, n, o1, o2, gt, pref)
            delocal int pref = 0
            delocal int gt = 0

            push(o1, scarto)
            push(o2, scarto)
        delocal int o2 = 0
        delocal int o1 = 0
        j1 -= 1
        j1 -= j
    delocal int j1 = 0

procedure ordina(int offs[], int blocco[], stack scarto, int n)
    local int m = 0
        m += n
        m -= 1
        local int i = 0
        from i == 0 do
            local int j = 0
            from j == 0 do
                call passo(offs, blocco, scarto, n, j)
                j += 1
            loop until j == m
            delocal int j = m
            i += 1
        loop until i == m
        delocal int i = m
        m += 1
        m -= n
    delocal int m = 0

// --- estrazione: ultima colonna e indice della rotazione originale ---------
//
//  out[i] e' l'ultimo carattere della rotazione i-esima nell'ordine, cioe' il
//  carattere in posizione n-1 di quella rotazione. idx e' la posizione, nel
//  nuovo ordine, della rotazione che parte da 0: e' l'informazione senza la
//  quale la trasformata non si inverte.
procedure estrai(int offs[], int blocco[], int out[], int n, int idx)
    local int i = 0
    from i == 0 do
        local int o = 0
        local int k = 0
            o += offs[i]
            k += n
            k -= 1
            local int c = 0
                call car(blocco, n, o, k, c)
                out[i] += c
                uncall car(blocco, n, o, k, c)
            delocal int c = 0
            if o == 0 then
                idx += i
            fi o == 0
            k -= n
            k += 1
            o -= offs[i]
        delocal int k = 0
        delocal int o = 0
        i += 1
    loop until i == n
    delocal int i = n

// --- trasformata inversa: da (out, idx) si ricostruisce il blocco -----------
//
//  Metodo classico di Burrows e Wheeler. Si costruisce il vettore T che, per
//  ogni riga della matrice ordinata, dice quale riga la precede; percorrendolo
//  da idx si legge il blocco originale a ritroso.
//
//      T[i] = #{ j : out[j] < out[i] } + #{ j < i : out[j] == out[i] }
//
//  cioe' la posizione che out[i] occupa nella prima colonna, che e' out
//  ordinata. I due conteggi si fanno con due scansioni, senza congiunzioni:
//  la `if` di Kairos confronta due espressioni e basta.

procedure conta_minori(int out[], int n, int c, int r)
    local int j = 0
    from j == 0 do
        if out[j] < c then
            r += 1
        fi out[j] < c
        j += 1
    loop until j == n
    delocal int j = n

procedure conta_uguali_prima(int out[], int i, int c, int r)
    if i > 0 then
        local int j = 0
        from j == 0 do
            if out[j] == c then
                r += 1
            fi out[j] == c
            j += 1
        loop until j == i
        delocal int j = i
    fi i > 0

procedure costruisci_T(int out[], int tv[], int n)
    local int i = 0
    from i == 0 do
        local int c = 0
        local int t = 0
            c += out[i]
            call conta_minori(out, n, c, t)
            call conta_uguali_prima(out, i, c, t)
            tv[i] += t
            t -= tv[i]
            c -= out[i]
        delocal int t = 0
        delocal int c = 0
        i += 1
    loop until i == n
    delocal int i = n

// Percorre T da idx e ricostruisce il blocco. Le posizioni visitate finiscono
// su `cammino`: sono il dato ausiliario di questo passo.
procedure cammina(int out[], int tv[], int blocco[], int cammino[], int idx, int n)
    local int p = 0
        p += idx
        local int k = 0
        from k == 0 do
            blocco[((n - 1) - k)] += out[p]       // a ritroso: l'ultimo carattere per primo
            local int q = 0
                q += tv[p]
                p <=> q
                cammino[k] += q          // q e' la posizione vecchia
                q -= cammino[k]
            delocal int q = 0
            k += 1
        loop until k == n
        delocal int k = n
        p -= idx
    delocal int p = 0


procedure identita(int a[], int n)
    local int i = 0
    from i == 0 do
        a[i] += i
        i += 1
    loop until i == n
    delocal int i = n

procedure lavoratore(int blocco[], int offs[], int out[], stack scarto,
                     stack colonna, channel c, int n)
    local int idx = 0
        call ordina(offs, blocco, scarto, n)
        call estrai(offs, blocco, out, n, idx)
        local int i = 0
        from i == 0 do
            local int t = 0
                t += out[i]
                push(t, colonna)
            delocal int t = 0
            i += 1
        loop until i == n
        delocal int i = n
        ssend(<idx, colonna>, c)
    delocal int idx = 0

procedure raccoglitore(channel c0, channel c1, stack col0, stack col1, stack indici)
    local int i0 = 0
    local int i1 = 0
        srecv(<i0, col0>, c0)
        srecv(<i1, col1>, c1)
        push(i0, indici)
        push(i1, indici)
    delocal int i1 = 0
    delocal int i0 = 0

procedure comprimi(int b0[], int b1[], int offs0[], int offs1[], int out0[], int out1[], stack sc0, stack sc1, stack st0, stack st1, stack col0, stack col1, stack indici, int n)
    local channel c0 = empty
    local channel c1 = empty
    par
        call lavoratore(b0, offs0, out0, sc0, st0, c0, n)
    and
        call lavoratore(b1, offs1, out1, sc1, st1, c1, n)
    and
        call raccoglitore(c0, c1, col0, col1, indici)
    rap
    delocal channel c1 = empty
    delocal channel c0 = empty

procedure main()
    stack sc0  stack sc1
    stack st0  stack st1
    stack col0  stack col1
    stack indici
    local int n = 6
    local int b0[6] = 0
    local int b1[6] = 0
    local int offs0[6] = 0
    local int offs1[6] = 0
    local int out0[6] = 0
    local int out1[6] = 0
    call identita(offs0, n)
    b0[0] += 2
    b0[1] += 1
    b0[2] += 3
    b0[3] += 1
    b0[4] += 3
    b0[5] += 1
    call identita(offs1, n)
    b1[0] += 1
    b1[1] += 3
    b1[2] += 1
    b1[3] += 3
    b1[4] += 1
    b1[5] += 2
    call comprimi(b0, b1, offs0, offs1, out0, out1, sc0, sc1, st0, st1, col0, col1, indici, n)
    show(col0)
    show(col1)
    show(indici)
    uncall comprimi(b0, b1, offs0, offs1, out0, out1, sc0, sc1, st0, st1, col0, col1, indici, n)
    b0[5] -= 1
    b0[4] -= 3
    b0[3] -= 1
    b0[2] -= 3
    b0[1] -= 1
    b0[0] -= 2
    uncall identita(offs0, n)
    b1[5] -= 2
    b1[4] -= 1
    b1[3] -= 3
    b1[2] -= 1
    b1[1] -= 3
    b1[0] -= 1
    uncall identita(offs1, n)
    delocal int out1[6] = 0
    delocal int out0[6] = 0
    delocal int offs1[6] = 0
    delocal int offs0[6] = 0
    delocal int b1[6] = 0
    delocal int b0[6] = 0
    delocal int n = 6
