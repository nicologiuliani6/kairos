    push(w29, __mn_scratch)
    push(w30, __mn_scratch)
    push(w31, __mn_scratch)
    local int j = 0
    from j == 0 loop
        local int w = 0
        pop(w, __mn_scratch)
        local int fits = 0
        if a >= w then
            fits += 1
        fi a >= w
        local int bit = 0
        if fits == 1 then
            bit += 1
            a -= w
        fi fits == 1
        local int r_dbl = 0
        r_dbl += r
        r += r_dbl
        push(r_dbl, __mn_hist)
        delocal int r_dbl = 0
        r += bit
        local int doable = 0
        if r >= 2 then
            doable += 1
        fi r >= 2
        if doable == 1 then
            r -= 2
            q += w
        fi doable == 1
        push(doable, __mn_hist)
        delocal int doable = 0
        push(bit, __mn_hist)
        delocal int bit = 0
        push(fits, __mn_hist)
        delocal int fits = 0
        push(w, __mn_hist)
        delocal int w = 0
        j += 1
    until j == 32
    push(j, __mn_hist)
    delocal int j = 0
    delocal int w31 = 0
    delocal int w30 = 0
    delocal int w29 = 0
    delocal int w28 = 0
    delocal int w27 = 0
    delocal int w26 = 0
    delocal int w25 = 0
    delocal int w24 = 0
    delocal int w23 = 0
    delocal int w22 = 0
    delocal int w21 = 0
    delocal int w20 = 0
    delocal int w19 = 0
    delocal int w18 = 0
    delocal int w17 = 0
    delocal int w16 = 0
    delocal int w15 = 0
    delocal int w14 = 0
    delocal int w13 = 0
    delocal int w12 = 0
    delocal int w11 = 0
    delocal int w10 = 0
    delocal int w9 = 0
    delocal int w8 = 0
    delocal int w7 = 0
    delocal int w6 = 0
    delocal int w5 = 0
    delocal int w4 = 0
    delocal int w3 = 0
    delocal int w2 = 0
    delocal int w1 = 0
    delocal int w0 = 0


// q = floor(t/2) con semantica divisione intera C su int; azzera t.
// `ts` copia stabile di t per il guard if/fi: nel ramo else t viene azzerato
// da move_int, quindi `fi t >= 0` sarebbe sempre TRUE — ts non viene toccato nei rami.
procedure __mn_floor_div2_signed(int t, int q, stack __mn_hist, stack __mn_scratch)
    local int r = 0
    local int ts = 0
    ts += t
    if ts >= 0 then
        call __mn_divmod_nonneg_div2(t, q, r, __mn_hist, __mn_scratch)
    else
        local int u = 0
        u -= t
        u += 1
        call __mn_divmod_nonneg_div2(u, q, r, __mn_hist, __mn_scratch)
        local int z = 0
        z -= q
        push(q, __mn_hist)
        call __mn_move_int(q, z, __mn_hist, __mn_scratch)
        local int sink = 0
        call __mn_move_int(sink, t, __mn_hist, __mn_scratch)
        push(sink, __mn_hist)
        delocal int sink = 0
        push(z, __mn_hist)
        delocal int z = 0
        push(u, __mn_hist)
        delocal int u = 0
    fi ts >= 0
    push(ts, __mn_hist)
    delocal int ts = 0
    push(r, __mn_hist)
    delocal int r = 0

// Bit k (0=LSB) dopo k shift aritmetici su a (semantica come int C).
// `from i == 0` + guard: FROM vero solo a i=0 (pre-loop), falso a i=1..k-1.
procedure __mn_bit_k_signed(int a, int kk, int bit_out, stack __mn_hist, stack __mn_scratch)
    local int t = 0
    t += a
    local int i = 0
    local int kp1 = 0
    kp1 += kk
    kp1 += 1
    from i == 0 loop
        if i != 0 then
            local int q = 0
            call __mn_floor_div2_signed(t, q, __mn_hist, __mn_scratch)
            t += q
            push(q, __mn_hist)
            delocal int q = 0
        fi i != 0
        i += 1
    until i == kp1
    local int qf = 0
    local int rf = 0
    local int ts = 0
    ts += t
    if ts >= 0 then
        call __mn_divmod_nonneg_div2(t, qf, rf, __mn_hist, __mn_scratch)
        bit_out += rf
    else
        local int u = 0
        u -= t
        call __mn_divmod_nonneg_div2(u, qf, rf, __mn_hist, __mn_scratch)
        bit_out += rf
        push(u, __mn_hist)
        delocal int u = 0
    fi ts >= 0
    push(ts, __mn_hist)
    delocal int ts = 0
    push(rf, __mn_hist)
    delocal int rf = 0
    push(qf, __mn_hist)
    delocal int qf = 0
    push(kp1, __mn_hist)
    delocal int kp1 = 0
    push(i, __mn_hist)
    delocal int i = 0
    push(t, __mn_hist)
    delocal int t = 0

// dst += (a & b) — bit-a-bit su 31 iterazioni (LSB… , come interi con bit signed).
// Pattern FLATTENED: nested `if abit then if bbit then dst += pow fi fi` triggers
// VM uncall bug (inner inverse fires unconditionally when outer cond true). Use
// `s = abit + bbit; if s == 2 then dst += pow fi s == 2` instead — single-stmt
// body if-fi inverts cleanly.
procedure __mn_and_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int k = 0
    local int pow = 1
    from k == 0 loop
        local int abit = 0
        local int bbit = 0
        call __mn_bit_k_signed(a, k, abit, __mn_hist, __mn_scratch)
        call __mn_bit_k_signed(b, k, bbit, __mn_hist, __mn_scratch)
        local int s = 0
        s += abit
        s += bbit
        if s == 2 then
            dst += pow
        fi s == 2
        s -= bbit
        s -= abit
        push(s, __mn_hist)
        delocal int s = 0
        k += 1
        local int next_pow = 0
        next_pow += pow
        next_pow += pow
        push(pow, __mn_hist)
        call __mn_move_int(pow, next_pow, __mn_hist, __mn_scratch)
        push(next_pow, __mn_hist)
        delocal int next_pow = 0
        push(bbit, __mn_hist)
        delocal int bbit = 0
        push(abit, __mn_hist)
        delocal int abit = 0
    until k == 31
    // Bit 31 (segno) in complemento a 2: contribuisce -2^31 (= -pow qui, pow==2^31).
    // Senza questo l'AND a 31 bit perdeva il bit segno (-1 & -1 → 2147483647).
    local int a31 = 0
    local int b31 = 0
    call __mn_bit_k_signed(a, k, a31, __mn_hist, __mn_scratch)
    call __mn_bit_k_signed(b, k, b31, __mn_hist, __mn_scratch)
    local int s31 = 0
    s31 += a31
    s31 += b31
    if s31 == 2 then
        dst -= pow
    fi s31 == 2
    s31 -= b31
    s31 -= a31
    push(s31, __mn_hist)
    delocal int s31 = 0
    push(b31, __mn_hist)
    delocal int b31 = 0
    push(a31, __mn_hist)
    delocal int a31 = 0
    push(pow, __mn_hist)
    delocal int pow = 0
    push(k, __mn_hist)
    delocal int k = 0

// dst += (a | b)
// `from k == 0`: stesso pattern di and_into.
procedure __mn_or_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int k = 0
    local int pow = 1
    from k == 0 loop
        local int abit = 0
        local int bbit = 0
        call __mn_bit_k_signed(a, k, abit, __mn_hist, __mn_scratch)
        call __mn_bit_k_signed(b, k, bbit, __mn_hist, __mn_scratch)
        local int s = 0
        s += abit
        s += bbit
        if s != 0 then
            dst += pow
        fi s != 0
        k += 1
        local int next_pow = 0
        next_pow += pow
        next_pow += pow
        push(pow, __mn_hist)
        call __mn_move_int(pow, next_pow, __mn_hist, __mn_scratch)
        push(next_pow, __mn_hist)
        delocal int next_pow = 0
        push(s, __mn_hist)
        delocal int s = 0
        push(bbit, __mn_hist)
        delocal int bbit = 0
        push(abit, __mn_hist)
        delocal int abit = 0
    until k == 31
    // Bit 31 (segno) in complemento a 2: contribuisce -2^31 (= -pow, pow==2^31).
    // Senza questo l'OR a 31 bit perdeva il bit segno (-5 | 8 → 2147483643).
    local int a31 = 0
    local int b31 = 0
    call __mn_bit_k_signed(a, k, a31, __mn_hist, __mn_scratch)
    call __mn_bit_k_signed(b, k, b31, __mn_hist, __mn_scratch)
    local int s31 = 0
    s31 += a31
    s31 += b31
    if s31 != 0 then
        dst -= pow
    fi s31 != 0
    s31 -= b31
    s31 -= a31
    push(s31, __mn_hist)
    delocal int s31 = 0
    push(b31, __mn_hist)
    delocal int b31 = 0
    push(a31, __mn_hist)
    delocal int a31 = 0
    push(pow, __mn_hist)
    delocal int pow = 0
    push(k, __mn_hist)
    delocal int k = 0

// dst += (x << n), n >= 0
// NOTA BUG VM: `if n != 0 then [from-loop] fi` con n==0 in inversione esegue
// il corpo una volta → i finisce a -1. Workaround peel-loop disponibile ma
// rallenta opt-uncall ~22x. Encrypt usa n=8 sempre, quindi if-fi è OK.
// Per n=0 vedere c_test/uncall_bug_shl_n0.kairos.
procedure __mn_shl_into(int dst, int x, int n, stack __mn_hist, stack __mn_scratch)
    local int pow = 1
    local int i = 0
    if n != 0 then
        from i == 0 loop
            i += 1
            local int np = 0
            np += pow
            np += pow
            push(pow, __mn_hist)
            call __mn_move_int(pow, np, __mn_hist, __mn_scratch)
            push(np, __mn_hist)
            delocal int np = 0
        until i == n
    fi n != 0
    call __mn_mul_into(dst, x, pow, __mn_hist, __mn_scratch)
    push(i, __mn_hist)
    delocal int i = 0
    push(pow, __mn_hist)
    delocal int pow = 0

// Dimezzamento UNSIGNED di un cell a 64 bit puro (nessun opcode nativo):
// q += floor(unsigned64(x)/2); r += unsigned64(x) mod 2; x = 0 (consumato).
// Necessario perché __mn_shr_into (sotto) applica shift logico anche a bit
// pattern con high bit set (x < 0 come signed int64, ma rappresenta un
// valore unsigned grande — es. u32/u64 dopo mask/xor). Con x >= 0 coincide
// con __mn_divmod_nonneg_fast(x,2); con x < 0 serve la correzione:
//   x rappresenta (complemento a 2) il valore unsigned x_u = x + 2^64.
//   Sia ab = |x| (negazione sicura per ogni x tranne INT64_MIN, unico
//   valore la cui negazione trabocca in complemento a 2 — gestito a parte),
//   qab = ab/2, rab = ab%2. Allora:
//     floor(x_u/2) = floor(x/2) + 2^63 = 2^63 - qab - rab
//   (floor(x/2) per x negativo pari = -qab; dispari = -(qab+1); in entrambi
//   i casi -qab-rab). r_u (bit meno significativo) = rab sempre, perché in
//   complemento a 2 bit0(-y) = bit0(y) per ogni intero y.
//   2^63 non è rappresentabile come int64 positivo: lo si ottiene sempre
//   come p62+p62 solo DOPO aver sottratto qab+rab da un p62 "di scorta"
//   (delta = p62 - qab - rab, poi q_u = p62 + delta) così nessun risultato
//   intermedio supera mai 2^63-1 (max int64).
procedure __mn_uhalve64(int x, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int two = 0
    two += 2
    // min64 = -2^63 (raddoppio sicuro da -1: resta negativo, mai overflow).
    // p62 = 2^62 (raddoppio sicuro da 1: resta positivo, mai overflow).
    local int min64 = 0
    min64 -= 1
    local int p62 = 1
    local int i = 0
    from i == 0 loop
        local int m2 = 0
        m2 += min64
        m2 += min64
        push(min64, __mn_hist)
        call __mn_move_int(min64, m2, __mn_hist, __mn_scratch)
        push(m2, __mn_hist)
        delocal int m2 = 0
        local int p2 = 0
        p2 += p62
        p2 += p62
        push(p62, __mn_hist)
        call __mn_move_int(p62, p2, __mn_hist, __mn_scratch)
        push(p2, __mn_hist)
        delocal int p2 = 0
        i += 1
    until i == 62
    local int is_min = 0
    if x == min64 then
        is_min += 1
    fi x == min64
    if is_min == 1 then
        // x = INT64_MIN: x_u = 2^63 esatto. q_u = 2^62, r_u = 0.
        q += p62
        local int sink = 0
        call __mn_move_int(sink, x, __mn_hist, __mn_scratch)
        push(sink, __mn_hist)
        delocal int sink = 0
    else
        local int neg = 0
        if x < 0 then
            neg += 1
        fi x < 0
        local int ab = 0
        if neg == 1 then
            ab -= x
        else
            ab += x
        fi neg == 1
        local int qab = 0
        local int rab = 0
        call __mn_divmod_nonneg_fast(ab, two, qab, rab, __mn_hist, __mn_scratch)
        if neg == 1 then
            local int delta = 0
            delta += p62
            delta -= qab
            delta -= rab
            q += delta
            q += p62
            push(delta, __mn_hist)
            delocal int delta = 0
            r += rab
        else
            q += qab
            r += rab
        fi neg == 1
        uncall __mn_divmod_nonneg_fast(ab, two, qab, rab, __mn_hist, __mn_scratch)
        delocal int rab = 0
        delocal int qab = 0
        if neg == 1 then
            ab += x
        else
            ab -= x
        fi neg == 1
        delocal int ab = 0
        local int sink2 = 0
        call __mn_move_int(sink2, x, __mn_hist, __mn_scratch)
        push(sink2, __mn_hist)
        delocal int sink2 = 0
        push(neg, __mn_hist)
        delocal int neg = 0
    fi is_min == 1
    push(is_min, __mn_hist)
    delocal int is_min = 0
    push(i, __mn_hist)
    delocal int i = 0
    push(p62, __mn_hist)
    delocal int p62 = 0
    push(min64, __mn_hist)
    delocal int min64 = 0
    two -= 2
    delocal int two = 0

// dst += (x >> n) unsigned (logical shift). Necessario per u32/u64 dove
// bit pattern del cell può avere high bit set (signed-negative); aritmetico
// >> sign-extende perdendo bit utili. __mn_uhalve64 usa semantica unsigned
// div2, puro (nessun opcode nativo — vedi sopra).
// NOTA BUG VM: stesso problema di __mn_shl_into per n==0. Encrypt usa n=8.
// Per n=0 vedere c_test/uncall_bug_shr_n0.kairos.
procedure __mn_shr_into(int dst, int x, int n, stack __mn_hist, stack __mn_scratch)
    local int t = 0
    t += x
    local int i = 0
    if n != 0 then
        from i == 0 loop
            i += 1
            local int qh = 0
            local int ph = 0
            call __mn_uhalve64(t, qh, ph, __mn_hist, __mn_scratch)
            t += qh
            push(ph, __mn_hist)
            delocal int ph = 0
            push(qh, __mn_hist)
            delocal int qh = 0
        until i == n
    fi n != 0
    dst += t
    push(i, __mn_hist)
    delocal int i = 0
    push(t, __mn_hist)
    delocal int t = 0

// Stampa intero con segno (show byte, char). Dipendenze: helpers.kairos, divmod.kairos.
// REVERSIBILE: usa `uncall __mn_divmod_nonneg` per ripristinare n e azzerare qu/rem.
// Permette `call __mn_putd_uint; uncall __mn_putd_uint` (show è no-op in inverse).

procedure __mn_putd_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int qu = 0
    local int rem = 0
    if n >= ten then
        call __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putd_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= ten
    ten -= 10
    delocal int rem = 0
    delocal int qu = 0
    delocal int ten = 0

// Variante fast: usa __mn_divmod_nonneg_fast (sub-lineare via mnhalve VM)
// invece di __mn_divmod_nonneg (lineare O(n/10)). Necessario per n grandi
// (es. %u runtime negative dove n può essere fino a 2^32-1).
procedure __mn_putd_uint_fast(int n, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int qu = 0
    local int rem = 0
    if n >= ten then
        call __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putd_uint_fast(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= ten
    ten -= 10
    delocal int rem = 0
    delocal int qu = 0
    delocal int ten = 0

procedure __mn_putd(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n < z then
        local int hy = 0
        hy += 45
        show(hy, char)
        hy -= 45
        delocal int hy = 0
        local int t = 0
        t -= n
        n += t
        n <=> t
        delocal int t = 0
        call __mn_putd_uint(n, __mn_hist, __mn_scratch)
        local int t2 = 0
        t2 -= n
        n += t2
        n <=> t2
        delocal int t2 = 0
    else
        call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    fi n < z
    delocal int z = 0

// `%+d` runtime: prepend `+` se n>=0, poi __mn_putd.
procedure __mn_putd_plus(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n >= z then
        local int p = 0
        p += 43
        show(p, char)
        p -= 43
        delocal int p = 0
    fi n >= z
    delocal int z = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)

// `% d` runtime: prepend ` ` se n>=0, poi __mn_putd.
procedure __mn_putd_space(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n >= z then
        local int sp = 0
        sp += 32
        show(sp, char)
        sp -= 32
        delocal int sp = 0
    fi n >= z
    delocal int z = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)

// Conta le cifre decimali di un n >= 0 (inclusivo: n=0 conta 1).
// d += digits(n). Reversibile: n e ten immutati nel body.
procedure __mn_dcount_unsigned(int n, int d, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int q = 0
    local int r = 0
    if n >= ten then
        call __mn_divmod_nonneg_fast(n, ten, q, r, __mn_hist, __mn_scratch)
        call __mn_dcount_unsigned(q, d, __mn_hist, __mn_scratch)
        d += 1
        uncall __mn_divmod_nonneg_fast(n, ten, q, r, __mn_hist, __mn_scratch)
    else
        d += 1
    fi n >= ten
    ten -= 10
    delocal int r = 0
    delocal int q = 0
    delocal int ten = 0

// Emette `count` spazi (codice 32). count immutato (loop counter su local rem).
procedure __mn_emit_spaces(int count, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if count > z then
        local int rem = 0
        rem += count
        from rem == count loop
            local int sp = 0
            sp += 32
            show(sp, char)
            sp -= 32
            delocal int sp = 0
            rem -= 1
        until rem == 0
        delocal int rem = 0
    fi count > z
    delocal int z = 0

// Emette `count` zeri ASCII (codice 48). count immutato.
procedure __mn_emit_zeros(int count, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if count > z then
        local int rem = 0
        rem += count
        from rem == count loop
            local int zc = 0
            zc += 48
            show(zc, char)
            zc -= 48
            delocal int zc = 0
            rem -= 1
        until rem == 0
        delocal int rem = 0
    fi count > z
    delocal int z = 0

// `%-Nd` runtime: emette `__mn_putd(n)` poi `(N - digits_of(n)) - (1 se n<0)`
// spazi a destra. Stesso schema di __mn_putd_width ma ordine show invertito.
procedure __mn_putd_width_left(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    call __mn_putd(n, __mn_hist, __mn_scratch)
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    push(d, __mn_hist)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0

// `%0Nd` runtime: se n<0 emette `-`, poi `(N - 1 - digits)` zeri, poi
// __mn_putd_uint(abs_n). Se n>=0 emette `(N - digits)` zeri poi __mn_putd_uint(n).
procedure __mn_putd_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    if n < z then
        local int hy = 0
        hy += 45
        show(hy, char)
        hy -= 45
        delocal int hy = 0
    fi n < z
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd_uint(abs_n, __mn_hist, __mn_scratch)
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    push(d, __mn_hist)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0

// `%Nu` runtime: emette (N - digits) spazi a sinistra, poi __mn_putd_uint(n).
procedure __mn_putd_uint_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

procedure __mn_putd_uint_width_left(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

procedure __mn_putd_uint_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

// `%Nd` runtime: emette `(N - digits_of(n)) - (1 se n<0)` spazi a sinistra,
// poi `__mn_putd(n)`. N può essere <= digits → nessun padding.
procedure __mn_putd_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    push(d, __mn_hist)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0

// Stampa intero non negativo in esadecimale minuscolo.
// Dipendenze: helpers.kairos, divmod.kairos.
// REVERSIBILE via `uncall __mn_divmod_nonneg` (vedi __mn_putd_uint).

procedure __mn_putx_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 16
    local int qu = 0
    local int rem = 0
    if n >= base then
        call __mn_divmod_nonneg_fast(n, base, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putx_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        local int ten = 0
        ten += 10
        if rem >= ten then
            ch += rem
            ch += 87
            show(ch, char)
            ch -= 87
            ch -= rem
        else
            ch += rem
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= rem
        fi rem >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, base, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        local int ten = 0
        ten += 10
        if n >= ten then
            ch += n
            ch += 87
            show(ch, char)
            ch -= 87
            ch -= n
        else
            ch += n
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= n
        fi n >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
    fi n >= base
    base -= 16
    delocal int rem = 0
    delocal int qu = 0
    delocal int base = 0

procedure __mn_putx(int n, stack __mn_hist, stack __mn_scratch)
    call __mn_putx_uint(n, __mn_hist, __mn_scratch)

// Conta le cifre esadecimali di un n >= 0 (n=0 conta 1).
// d += hex_digits(n). Reversibile via uncall divmod_nonneg.
procedure __mn_hcount_unsigned(int n, int d, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 16
    local int q = 0
    local int r = 0
    if n >= base then
        call __mn_divmod_nonneg_fast(n, base, q, r, __mn_hist, __mn_scratch)
        call __mn_hcount_unsigned(q, d, __mn_hist, __mn_scratch)
        d += 1
        uncall __mn_divmod_nonneg_fast(n, base, q, r, __mn_hist, __mn_scratch)
    else
        d += 1
    fi n >= base
    base -= 16
    delocal int r = 0
    delocal int q = 0
    delocal int base = 0

// `%Nx` runtime: emette (N - hex_digits(n)) spazi a sinistra, poi __mn_putx.
procedure __mn_putx_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putx(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

// `%-Nx` runtime: __mn_putx poi (N - hex_digits) spazi a destra.
procedure __mn_putx_width_left(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    call __mn_putx(n, __mn_hist, __mn_scratch)
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

// `%0Nx` runtime: emette (N - hex_digits) zeri ASCII, poi __mn_putx.
procedure __mn_putx_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putx(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

// Split u64 hi/lo (bit 32-63 / 0-31) di un cell a 64 bit, puro (nessun
// opcode nativo — era MNSPLIT32 O(1) host C, ora __mn_divmod_nonneg_fast
// contro 2^32, O(32) iterazioni via raddoppio puro). Forward azzera src
// (consumato, come il contratto nativo originale); inverse (uncall)
// ripristina src e azzera hi/lo.
// x >= 0: divmod diretta contro 2^32. x < 0 (high bit set = valore unsigned
// grande in complemento a 2, x_u = x + 2^64): ab = |x| (negazione sicura
// salvo x == INT64_MIN, caso limite gestito a parte — stessa cautela di
// __mn_uhalve64 in bits.kairos), qab = ab/2^32, rab = ab%2^32:
//   lo = (rab==0) ? 0 : (2^32 - rab);  hi = 2^32 - qab - (rab==0 ? 0 : 1)
// (qui il modulo è 2^32, non 2^63: hi resta sempre < 2^32, ben dentro il
// range int64 positivo — nessun accorgimento extra per overflow intermedi,
// a differenza di __mn_uhalve64).
procedure __mn_u64_split32(int src, int hi, int lo, stack __mn_hist, stack __mn_scratch)
    local int xorig = 0
    xorig += src
    local int mod32 = 1
    local int i = 0
    from i == 0 loop
        local int m2 = 0
        m2 += mod32
        m2 += mod32
        push(mod32, __mn_hist)
        call __mn_move_int(mod32, m2, __mn_hist, __mn_scratch)
        push(m2, __mn_hist)
        delocal int m2 = 0
        i += 1
    until i == 32
    local int min64 = 0
    min64 -= 1
    local int j = 0
    from j == 0 loop
        local int m2b = 0
        m2b += min64
        m2b += min64
        push(min64, __mn_hist)
        call __mn_move_int(min64, m2b, __mn_hist, __mn_scratch)
        push(m2b, __mn_hist)
        delocal int m2b = 0
        j += 1
    until j == 63
    local int is_min = 0
    if xorig == min64 then
        is_min += 1
    fi xorig == min64
    if is_min == 1 then
        // src = INT64_MIN: x_u = 2^63 esatto. hi = 2^31, lo = 0.
        local int p31 = 1
        local int k = 0
        from k == 0 loop
            local int p2 = 0
            p2 += p31
            p2 += p31
            push(p31, __mn_hist)
            call __mn_move_int(p31, p2, __mn_hist, __mn_scratch)
            push(p2, __mn_hist)
            delocal int p2 = 0
            k += 1
        until k == 31
        hi += p31
        push(k, __mn_hist)
        delocal int k = 0
        push(p31, __mn_hist)
        delocal int p31 = 0
    else
        local int neg = 0
        if xorig < 0 then
            neg += 1
        fi xorig < 0
        local int ab = 0
        if neg == 1 then
            ab -= xorig
        else
            ab += xorig
        fi neg == 1
        local int qab = 0
        local int rab = 0
        call __mn_divmod_nonneg_fast(ab, mod32, qab, rab, __mn_hist, __mn_scratch)
        if neg == 1 then
            local int rz = 0
            if rab == 0 then
                rz += 1
            fi rab == 0
            if rz == 0 then
                lo += mod32
                lo -= rab
                hi += mod32
                hi -= qab
                hi -= 1
            else
                hi += mod32
                hi -= qab
            fi rz == 0
            push(rz, __mn_hist)
            delocal int rz = 0
        else
            lo += rab
            hi += qab
        fi neg == 1
        uncall __mn_divmod_nonneg_fast(ab, mod32, qab, rab, __mn_hist, __mn_scratch)
        delocal int rab = 0
        delocal int qab = 0
        if neg == 1 then
            ab += xorig
        else
            ab -= xorig
        fi neg == 1
        delocal int ab = 0
        push(neg, __mn_hist)
        delocal int neg = 0
    fi is_min == 1
    push(is_min, __mn_hist)
    delocal int is_min = 0
    // Consuma src (mnsplit32 lo azzerava nativamente).
    local int sink = 0
    call __mn_move_int(sink, src, __mn_hist, __mn_scratch)
    push(sink, __mn_hist)
    delocal int sink = 0
    push(j, __mn_hist)
    delocal int j = 0
    push(min64, __mn_hist)
    delocal int min64 = 0
    push(xorig, __mn_hist)
    delocal int xorig = 0
    push(mod32, __mn_hist)
    delocal int mod32 = 0
    push(i, __mn_hist)
    delocal int i = 0

// Stampa intero u64 in esadecimale lowercase, no leading zeros.
// Per cell >= 2^32 oppure cell < 0 (high bit set in signed int64), serve
// gestione esplicita: __mn_putx_uint riceve solo nonneg fino a ~2^31.
// Split: hi = bits 32-63 (u64), lo = bits 0-31. Se hi==0, print lo. Else
// print hi poi lo padded a 8 cifre.
procedure __mn_putx_u64(int n, stack __mn_hist, stack __mn_scratch)
    local int hi = 0
    local int lo = 0
    call __mn_u64_split32(n, hi, lo, __mn_hist, __mn_scratch)
    local int z = 0
    if hi > z then
        call __mn_putx_uint(hi, __mn_hist, __mn_scratch)
        local int eight = 0
        eight += 8
        call __mn_putx_width_zero(lo, eight, __mn_hist, __mn_scratch)
        eight -= 8
        delocal int eight = 0
    else
        call __mn_putx_uint(lo, __mn_hist, __mn_scratch)
    fi hi > z
    delocal int z = 0
    uncall __mn_u64_split32(n, hi, lo, __mn_hist, __mn_scratch)
    delocal int lo = 0
    delocal int hi = 0

// ===== Variante UPPERCASE (%X / %llX): identica a putx ma cifre A-F (+55). =====
procedure __mn_putX_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 16
    local int qu = 0
    local int rem = 0
    if n >= base then
        call __mn_divmod_nonneg_fast(n, base, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putX_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        local int ten = 0
        ten += 10
        if rem >= ten then
            ch += rem
            ch += 55
            show(ch, char)
            ch -= 55
            ch -= rem
        else
            ch += rem
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= rem
        fi rem >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, base, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        local int ten = 0
        ten += 10
        if n >= ten then
            ch += n
            ch += 55
            show(ch, char)
            ch -= 55
            ch -= n
        else
            ch += n
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= n
        fi n >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
    fi n >= base
    base -= 16
    delocal int rem = 0
    delocal int qu = 0
    delocal int base = 0

procedure __mn_putX(int n, stack __mn_hist, stack __mn_scratch)
    call __mn_putX_uint(n, __mn_hist, __mn_scratch)

// `%0NX` uppercase: (N - hex_digits) zeri poi __mn_putX.
procedure __mn_putX_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putX(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

// `%NX` uppercase: (N - hex_digits) spazi poi __mn_putX.
procedure __mn_putX_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putX(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

// u64 uppercase no leading zeros.
procedure __mn_putX_u64(int n, stack __mn_hist, stack __mn_scratch)
    local int hi = 0
    local int lo = 0
    call __mn_u64_split32(n, hi, lo, __mn_hist, __mn_scratch)
    local int z = 0
    if hi > z then
        call __mn_putX_uint(hi, __mn_hist, __mn_scratch)
        local int eight = 0
        eight += 8
        call __mn_putX_width_zero(lo, eight, __mn_hist, __mn_scratch)
        eight -= 8
        delocal int eight = 0
    else
        call __mn_putX_uint(lo, __mn_hist, __mn_scratch)
    fi hi > z
    delocal int z = 0
    uncall __mn_u64_split32(n, hi, lo, __mn_hist, __mn_scratch)
    delocal int lo = 0
    delocal int hi = 0

// `%0WllX` u64 uppercase zero-pad a W (W>=16: hi(8)+lo(8), + (W-16) zeri).
procedure __mn_putX_u64_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int hi = 0
    local int lo = 0
    call __mn_u64_split32(n, hi, lo, __mn_hist, __mn_scratch)
    local int sixteen = 0
    sixteen += 16
    local int extra = 0
    extra += width
    extra -= sixteen
    local int zp = 0
    if extra > zp then
        call __mn_emit_zeros(extra, __mn_hist, __mn_scratch)
    fi extra > zp
    extra -= width
    extra += sixteen
    delocal int zp = 0
    delocal int extra = 0
    sixteen -= 16
    delocal int sixteen = 0
    local int eight = 0
    eight += 8
    call __mn_putX_width_zero(hi, eight, __mn_hist, __mn_scratch)
    call __mn_putX_width_zero(lo, eight, __mn_hist, __mn_scratch)
    eight -= 8
    delocal int eight = 0
    uncall __mn_u64_split32(n, hi, lo, __mn_hist, __mn_scratch)
    delocal int lo = 0
    delocal int hi = 0

// Stampa intero non negativo in ottale.
// Dipendenze: helpers.kairos, divmod.kairos.
// REVERSIBILE via `uncall __mn_divmod_nonneg` (vedi __mn_putd_uint).

procedure __mn_puto_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 8
    local int qu = 0
    local int rem = 0
    if n >= base then
        call __mn_divmod_nonneg(n, base, qu, rem, __mn_hist, __mn_scratch)
        call __mn_puto_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        uncall __mn_divmod_nonneg(n, base, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= base
    base -= 8
    delocal int rem = 0
    delocal int qu = 0
    delocal int base = 0

procedure __mn_puto(int n, stack __mn_hist, stack __mn_scratch)
    call __mn_puto_uint(n, __mn_hist, __mn_scratch)

// Conta le cifre ottali di n >= 0 (n=0 conta 1).
procedure __mn_ocount_unsigned(int n, int d, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 8
    local int q = 0
    local int r = 0
    if n >= base then
        call __mn_divmod_nonneg(n, base, q, r, __mn_hist, __mn_scratch)
        call __mn_ocount_unsigned(q, d, __mn_hist, __mn_scratch)
        d += 1
        uncall __mn_divmod_nonneg(n, base, q, r, __mn_hist, __mn_scratch)
    else
        d += 1
    fi n >= base
    base -= 8
    delocal int r = 0
    delocal int q = 0
    delocal int base = 0

procedure __mn_puto_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_ocount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_puto(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

procedure __mn_puto_width_left(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_ocount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    call __mn_puto(n, __mn_hist, __mn_scratch)
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

procedure __mn_puto_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_ocount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_puto(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

// Pool puntatori Mnemo — generato, N=6 celle (__mn_mem0..__mn_mem5).
// Header per-blocco (scritto dal lowering): mem{ctr}=nblk; ptr=ctr+1.
// Dispatch slot→cella via BINARY SEARCH (`if slot < mid`): O(log N) per
// accesso invece che O(N) lineare → deref a indice runtime molto più veloce.

procedure __mn_pool_alloc(int ctr, int out_slot, int nblk, stack __mn_hist, stack __mn_scratch)
    push(out_slot, __mn_hist)
    out_slot += ctr
    out_slot += 1
    ctr += nblk
    ctr += 1

