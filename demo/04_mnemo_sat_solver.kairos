// Sposta il valore di src in dst (src azzerato) usando uno stack locale come "garbage" / condotto.
// La VM implementa `pop(dst, …)` come `*dst += valore`: per sostituire dst, azzeralo prima con
// `push(dst, hist)` sullo stack Janus del caller, poi `call __mn_move_int(dst, src)`.
procedure __mn_move_int(int dst, int src, stack __mn_hist, stack __mn_scratch)
    local stack __mn_g = nil
    push(src, __mn_g)
    pop(dst, __mn_g)
    delocal stack __mn_g = nil

// Mask x a 32 bit bassi: x = x & 0xFFFFFFFF, puro (nessun opcode nativo,
// era MNSPLIT32 O(1) host C — ora __mn_divmod_nonneg_fast contro 2^32,
// O(32) iterazioni, costruito via raddoppio puro).
// lo = unsigned64(x) mod 2^32: per x >= 0 è la divmod diretta; per x < 0
// (bit pattern col high bit set) si usa l'identità "negate mod":
// (-a) mod m = 0 se (a mod m)==0, altrimenti m - (a mod m), con a = |x|.
// Negare x è sempre sicuro qui (m = 2^32 è minuscolo rispetto a 2^63, non
// serve la cautela INT64_MIN di __mn_uhalve64 in bits.kairos).
procedure __mn_mask_u32(int x, stack __mn_hist, stack __mn_scratch)
    local int xorig = 0
    xorig += x
    local int mod32 = 1
    local int i = 0
    from i == 0 loop
        local int m2 = 0
        m2 += mod32
        m2 += mod32
        push(mod32, __mn_hist)
        call __mn_move_int(mod32, m2, __mn_hist, __mn_scratch)
        push(m2, __mn_hist)
        delocal int m2 = 0
        i += 1
    until i == 32
    local int neg = 0
    if xorig < 0 then
        neg += 1
    fi xorig < 0
    local int ab = 0
    if neg == 1 then
        ab -= xorig
    else
        ab += xorig
    fi neg == 1
    local int q = 0
    local int r = 0
    call __mn_divmod_nonneg_fast(ab, mod32, q, r, __mn_hist, __mn_scratch)
    local int lo = 0
    if neg == 1 then
        local int rz = 0
        if r == 0 then
            rz += 1
        fi r == 0
        if rz == 0 then
            lo += mod32
            lo -= r
        fi rz == 0
        push(rz, __mn_hist)
        delocal int rz = 0
    else
        lo += r
    fi neg == 1
    uncall __mn_divmod_nonneg_fast(ab, mod32, q, r, __mn_hist, __mn_scratch)
    delocal int r = 0
    delocal int q = 0
    if neg == 1 then
        ab += xorig
    else
        ab -= xorig
    fi neg == 1
    delocal int ab = 0
    push(neg, __mn_hist)
    delocal int neg = 0
    // Consuma x (mnsplit32 lo azzerava come effetto nativo; qui esplicito).
    local int sink = 0
    call __mn_move_int(sink, x, __mn_hist, __mn_scratch)
    push(sink, __mn_hist)
    delocal int sink = 0
    x += lo
    push(lo, __mn_hist)
    delocal int lo = 0
    push(xorig, __mn_hist)
    delocal int xorig = 0
    push(mod32, __mn_hist)
    delocal int mod32 = 0
    push(i, __mn_hist)
    delocal int i = 0

// Prodotto: dst += a * b usando solo somme ripetute (Kairos non ha *).
// b deve essere >= 0; a e b non vengono distrutti. (b == 0 → nessuna iterazione.)
// `from i == 0` (non `< b`): FROM vero solo allo stato pre-loop (i=0),
// falso agli stati intermedi (i=1..b-1) — necessario per l'inversione Kairos.
procedure __mn_mul_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int i = 0
    if b != 0 then
        from i == 0 loop
            i += 1
            dst += a
        until i == b
    fi b != 0
    delocal int i = b

// Prodotto signed: dst += a * b dove b può essere negativo.
// Reversibile: guard `b < z` non si modifica nel body (b e z immutabili).
procedure __mn_mul_signed_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int abs_b = 0
    if b < z then
        abs_b -= b
    else
        abs_b += b
    fi b < z
    call __mn_mul_into(dst, a, abs_b, __mn_hist, __mn_scratch)
    if b < z then
        local int t = 0
        t -= dst
        dst += t
        dst <=> t
        delocal int t = 0
    fi b < z
    if b < z then
        abs_b += b
    else
        abs_b -= b
    fi b < z
    delocal int abs_b = 0
    delocal int z = 0

// Divisione e resto: a, b interi con a >= 0 e b > 0; q = 0 e r = 0 all'ingresso.
// Uscita: q = a/b, r = a%b, a = 0. Il dividendo viene spostato in r via __mn_move_int (stack locale).
// `from q == 0`: FROM vero solo quando q=0 (pre-loop); falso a q=1,2,... (stati intermedi).
// `saved_r` copia a per il guard `if/fi`: la condizione non cambia durante il corpo.
procedure __mn_divmod_nonneg(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    call __mn_move_int(r, a, __mn_hist, __mn_scratch)
    local int saved_r = 0
    saved_r += r
    if saved_r >= b then
        from q == 0 loop
            r -= b
            q += 1
        until r < b
    fi saved_r >= b
    push(saved_r, __mn_hist)
    delocal int saved_r = 0

// Divisione/resto signed C99 (truncamento verso zero, segno resto = segno
// dividendo). q = 0, r = 0 all'ingresso; a, b interi qualsiasi (b != 0
// richiesto). Reversibile: guard di segno (a<z / b<z) immutabili nel body.
procedure __mn_divmod_signed(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int abs_a = 0
    if a < z then
        abs_a -= a
    else
        abs_a += a
    fi a < z
    local int abs_b = 0
    if b < z then
        abs_b -= b
    else
        abs_b += b
    fi b < z
    local int qu = 0
    local int ru = 0
    call __mn_divmod_nonneg(abs_a, abs_b, qu, ru, __mn_hist, __mn_scratch)
    if a < z then
        if b < z then
            q += qu
        else
            q -= qu
        fi b < z
        r -= ru
    else
        if b < z then
            q -= qu
        else
            q += qu
        fi b < z
        r += ru
    fi a < z
    uncall __mn_divmod_nonneg(abs_a, abs_b, qu, ru, __mn_hist, __mn_scratch)
    delocal int ru = 0
    delocal int qu = 0
    if b < z then
        abs_b += b
    else
        abs_b -= b
    fi b < z
    delocal int abs_b = 0
    if a < z then
        abs_a += a
    else
        abs_a -= a
    fi a < z
    delocal int abs_a = 0
    delocal int z = 0

// Divmod reversibile O(63) passi FISSI, 100% Kairos puro (nessun opcode
// nativo). Sostituisce la vecchia versione basata su MNHALVE nativo — stessa
// interfaccia. Fase 1 costruisce 63 pesi 1,2,4,...,2^62 via variabili
// FRESCHE (w0..w62, mai self-referenziali: `x += x` è un errore statico in
// Kairos) — NESSUNA `call` nel loop di raddoppio (a differenza di and_into/
// or_into che usano `call __mn_move_int` per il proprio raddoppio: qui va
// evitato perché __mn_divmod_nonneg_fast è a sua volta nel path caldo di
// and_into/or_into via __mn_divmod_nonneg_div2 → __mn_bit_k_signed, chiamato
// O(k^2) volte; l'overhead di call/return per ogni raddoppio moltiplicato per
// le tante invocazioni rendeva and/or impraticabilmente lenti). 63 pesi
// coprono qualunque nonneg int64 (2^62 = bit più alto per un nonneg a 63 bit).
// Fase 2 ripopa MSB-first (stack LIFO: pushati crescenti, escono
// decrescenti), decodifica il bit di t confrontando t>=w, e fa la divisione
// binaria a scorrimento contro b: r=2r+bit; se r>=b, r-=b e q+=w (stesso peso
// serve sia per il bit di a sia per il bit di q — bit i di a e bit i di q
// condividono 2^i nella divisione binaria standard).
// Input: a >= 0, b > 0, q = 0, r = 0. Output: q=a/b, r=a%b, a inalterato.
procedure __mn_divmod_nonneg_fast(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int t = 0
    t += a
    local int w0 = 1
    local int w1 = 0
    w1 += w0
    w1 += w0
    local int w2 = 0
    w2 += w1
    w2 += w1
    local int w3 = 0
    w3 += w2
    w3 += w2
    local int w4 = 0
    w4 += w3
    w4 += w3
    local int w5 = 0
    w5 += w4
    w5 += w4
    local int w6 = 0
    w6 += w5
    w6 += w5
    local int w7 = 0
    w7 += w6
    w7 += w6
    local int w8 = 0
    w8 += w7
    w8 += w7
    local int w9 = 0
    w9 += w8
    w9 += w8
    local int w10 = 0
    w10 += w9
    w10 += w9
    local int w11 = 0
