// Resto signed: estrae solo r da __mn_divmod_signed, scarta q via uncall
// dopo aver salvato r. Reversibilità preservata: uncall ripristina q=0,
// r=0, a/b inalterati.
procedure __mn_mod_signed(int a, int b, int r, stack __mn_hist, stack __mn_scratch)
    local int q = 0
    call __mn_divmod_signed(a, b, q, r, __mn_hist, __mn_scratch)
    local int r_save = 0
    r_save += r
    uncall __mn_divmod_signed(a, b, q, r, __mn_hist, __mn_scratch)
    r += r_save
    push(r_save, __mn_hist)
    delocal int r_save = 0
    delocal int q = 0

// Operazioni bitwise via aritmetica (Kairos non ha &, |, <<, >>).
// Richiede helpers.kairos, mul.kairos, divmod.kairos.
// Convenzione: gli *_into fanno dst += f(...) assumendo dst partenza dal caller.

// Chiamate con divisore 2: le `call` Kairos accettano solo identificatori, non `2` letterale.
// O(32) passi FISSI, 100% puro — VERSIONE SNELLA dedicata (non passa per
// __mn_divmod_nonneg_fast): questo è il path caldissimo di and_into/or_into
// (__mn_bit_k_signed lo chiama O(k) volte per bit, O(k^2) volte totali per
// and/or su 31 bit) — niente `call` extra, opera direttamente su `a` (che
// deve comunque azzerarsi in uscita, come il contratto nativo mnhalve
// originale, quindi non serve nessuna copia/sink separata).
procedure __mn_divmod_nonneg_div2(int a, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int w0 = 1
    local int w1 = 0
    w1 += w0
    w1 += w0
    local int w2 = 0
    w2 += w1
    w2 += w1
