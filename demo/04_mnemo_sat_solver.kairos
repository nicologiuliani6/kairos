    w12 += w11
    local int w13 = 0
    w13 += w12
    w13 += w12
    local int w14 = 0
    w14 += w13
    w14 += w13
    local int w15 = 0
    w15 += w14
    w15 += w14
    local int w16 = 0
    w16 += w15
    w16 += w15
    local int w17 = 0
    w17 += w16
