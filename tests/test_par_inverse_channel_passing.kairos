// uncall di un par con delega: il canale passato in un messaggio torna al
// suo ricevente anche all'indietro, e l'inverso si accoppia come in avanti.
procedure w(channel c1, channel c2, int x, int y)
    par
        ssend(<c2>, c1)
    and
        local channel d = empty
        srecv(<d>, c1)
        ssend(<x>, d)
        delocal channel d = empty
    and
        srecv(<y>, c2)
    rap

procedure main()
    local channel c1 = empty
    local channel c2 = empty
    local int x = 7
    local int y = 0
    call w(c1, c2, x, y)
    show(y)
    uncall w(c1, c2, x, y)
    show(x)
    delocal int y = 0
    delocal int x = 7
    delocal channel c2 = empty
    delocal channel c1 = empty
