// Nessun limite nelle strutture del motore di inversione dinamico (uncall di
// procedure non ricorsive): 40 cicli in una procedura e 40 cicli annidati
// (prima al più 32, gli altri ignorati: qui il più interno gira tre volte), 40 par in una procedura (prima 32,
// le istruzioni dei par in più venivano invertite due volte), una guardia di
// if lunga oltre 256 caratteri (prima errore esplicito). Ogni call è seguita
// dall'uncall e i delocal controllano che lo stato torni quello di partenza.
procedure cicli(int x)
    local int i = 0
    from i == 0 do
        x += 1
        i += 1
