procedure guardia(int x, int valore_di_riferimento_unitario)
    if x == ((valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario) - (valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario)) then
        x += 5
    else
        x += 7
    fi x == (((valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario) - (valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario + valore_di_riferimento_unitario)) + 5)

procedure main()
    int x
    int y
    int u
    u += 1
    call cicli(x)
    show(x)
    local int chk = 0
    chk += x
    delocal int chk = 2460
    uncall cicli(x)
    call annidati(x)
    show(x)
    uncall annidati(x)
    call tanti_par(x, y)
    show(x)
    show(y)
    uncall tanti_par(x, y)
    call guardia(x, u)
    show(x)
    uncall guardia(x, u)
    local int fine = 0
    fine += x
    fine += y
    delocal int fine = 0
