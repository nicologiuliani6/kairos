// Nessun limite sul numero di rami di un par: 24 rami (la VM ne lanciava al
// più 16 e ignorava gli altri in silenzio). Ogni ramo incrementa la sua
// variabile; il delocal della somma controlla che li abbia eseguiti tutti.
// Poi uncall della procedura col par, per l'inversione.
procedure tutti(int x0, int x1, int x2, int x3, int x4, int x5, int x6, int x7, int x8, int x9, int x10, int x11, int x12, int x13, int x14, int x15, int x16, int x17, int x18, int x19, int x20, int x21, int x22, int x23)
    par
        x0 += 1
    and
        x1 += 2
    and
        x2 += 3
    and
        x3 += 4
    and
        x4 += 5
    and
        x5 += 6
    and
        x6 += 7
    and
        x7 += 8
    and
        x8 += 9
    and
        x9 += 10
    and
        x10 += 11
    and
        x11 += 12
    and
        x12 += 13
    and
        x13 += 14
    and
        x14 += 15
    and
        x15 += 16
    and
        x16 += 17
    and
        x17 += 18
    and
        x18 += 19
    and
        x19 += 20
    and
        x20 += 21
    and
        x21 += 22
    and
        x22 += 23
    and
        x23 += 24
    rap

procedure main()
    int x0
    int x1
    int x2
    int x3
    int x4
    int x5
    int x6
    int x7
    int x8
    int x9
    int x10
    int x11
    int x12
    int x13
    int x14
    int x15
    int x16
    int x17
    int x18
    int x19
    int x20
    int x21
    int x22
    int x23
    call tutti(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23)
    local int somma = 0
    somma += x0
    somma += x1
    somma += x2
    somma += x3
    somma += x4
    somma += x5
    somma += x6
    somma += x7
    somma += x8
    somma += x9
    somma += x10
    somma += x11
    somma += x12
    somma += x13
    somma += x14
    somma += x15
    somma += x16
    somma += x17
    somma += x18
    somma += x19
    somma += x20
    somma += x21
    somma += x22
    somma += x23
    show(somma)
    delocal int somma = 300
    uncall tutti(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23)
    show(x0)
    show(x23)
