// Inverso di un ciclo il cui contatore scende sotto zero: all'indietro si
// ripete finché la guardia from è falsa, qualunque sia il segno.
procedure p(int a, int b)
    from b == 0 do
        b -= 1
        a += 1
    loop until b == (0 - 3)

procedure main()
    local int a = 0
    local int b = 0
    call p(a, b)
    show(a)
    show(b)
    uncall p(a, b)
    delocal int b = 0
    delocal int a = 0
