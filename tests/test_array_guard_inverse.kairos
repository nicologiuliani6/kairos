// Array nelle guardie: l'inversione di un if rivaluta la cella, non una variabile.
procedure cnt(int out[], int n, int c, int r)
    local int j = 0
    from j == 0 do
        if out[j] == c then
            r += 1
        fi out[j] == c
        j += 1
    loop until j == n
    delocal int j = n

procedure main()
    local int a[3] = 0
    local int n = 3
    local int c = 0
    local int r = 0
    a[0] += 1
    a[1] += 2
    a[2] += 1
    c += 1
    call cnt(a, n, c, r)
    show(r)
    uncall cnt(a, n, c, r)
    show(r)
    c -= 1
    a[2] -= 1
    a[1] -= 2
    a[0] -= 1
    delocal int r = 0
    delocal int c = 0
    delocal int n = 3
    delocal int a[3] = 0
