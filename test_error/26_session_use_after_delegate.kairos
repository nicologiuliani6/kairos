// Errore VM atteso: uso di un canale dopo averlo delegato.
//
// Il channel 'c' e' fra il primo e il secondo thread. Il primo lo spedisce al
// terzo sul canale di trasporto 't', cioe' lo delega, ma poi continua a usarlo.
// A quel punto i titolari di 'c' sono il secondo e il terzo thread, e il primo
// sarebbe un terzo titolare: viene fermato.
//
// E' la condizione "smetti di usarlo prima che l'altro cominci". Non e'
// verificabile leggendo il testo del programma, perche' il nuovo titolare
// riceve il canale sotto un altro nome ('preso'): serve guardare l'identita'
// del canale a runtime, che e' quello che fa src/vm/vm_session.h.
procedure main()
    local channel c = empty
    local channel t = empty
    local int a = 0
    local int b = 0
    local int d = 0
    a += 1

    par
        ssend(<c>, t)
        ssend(<a>, c)
    and
        srecv(<b>, c)
    and
        local channel preso = empty
        srecv(<preso>, t)
        srecv(<d>, preso)
        delocal channel preso = empty
    rap
