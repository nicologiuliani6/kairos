// Errore VM atteso: terzo titolare. Il channel 'c' e' usato da TRE thread
// concorrenti nello stesso blocco PAR (uno ssend e due srecv). La sessione e'
// binaria: al piu' due titolari per canale in ogni istante, altrimenti non e'
// determinato chi sia il partner di una data offerta ch!/ch?. Non e' piu' un
// errore di compilazione: la titolarita' e' stato a RUNTIME e puo' cambiare
// durante l'esecuzione (delega), quindi la si sorveglia dove la si osserva,
// in src/vm/vm_session.h.
procedure main()
    local channel c = empty
    local int v = 0
    v += 1
    local int a = 0
    local int b = 0
    par
        ssend(<v>, c)
    and
        srecv(<a>, c)
    and
        srecv(<b>, c)
    rap
